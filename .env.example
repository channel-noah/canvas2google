# Copy this file to .env and fill in real values. Never commit .env.

# --- Command-line tool ---------------------------------------------------
# Canvas -> Calendar -> "Calendar Feed" link. Treat it like a password:
# anyone with this URL can read your calendar.
CANVAS_FEED_URL=https://YOUR-SCHOOL.instructure.com/feeds/calendars/user_REPLACE_ME.ics

# --- Web app ---------------------------------------------------------------
# Signs session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=REPLACE_ME

# Encrypts feed URLs and Google tokens in the database. Keep a backup: losing it
# makes stored secrets unreadable. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=REPLACE_ME

# "Web application" OAuth client from Google Cloud Console (not the Desktop one).
GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_ME

# Comma-separated Google accounts allowed to sign in.
ALLOWED_EMAILS=you@example.com

# Optional (defaults shown):
# OAUTH_REDIRECT_URI=http://localhost:5000/auth/callback
# DATABASE_PATH=instance/canvas2google.db
# SECURE_COOKIES=false   # set true when served over HTTPS
