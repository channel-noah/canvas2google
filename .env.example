# Copy this file to .env and fill in real values. Never commit .env.

# --- Command-line tool ---------------------------------------------------
# Canvas -> Calendar -> "Calendar Feed" link. Treat it like a password:
# anyone with this URL can read your calendar.
CANVAS_FEED_URL=https://YOUR-SCHOOL.instructure.com/feeds/calendars/user_REPLACE_ME.ics

# --- Web app ---------------------------------------------------------------
# Signs session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=REPLACE_ME

# Encrypts feed URLs and Google tokens in the database. Keep a backup: losing it
# makes stored secrets unreadable. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=REPLACE_ME

# "Web application" OAuth client from Google Cloud Console (not the Desktop one).
GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_ME

# Who can sign up: "invite" (only ALLOWED_EMAILS) or "open" (any verified Google account).
SIGNUP_MODE=invite
# Comma-separated Google accounts allowed to sign in (required when SIGNUP_MODE=invite).
ALLOWED_EMAILS=you@example.com
# New sign-ups are refused once this many accounts exist (Google caps unverified apps at 100).
# MAX_USERS=90

# Optional (defaults shown):
# OAUTH_REDIRECT_URI=http://localhost:5000/auth/callback
# DATABASE_URL=sqlite:///instance/canvas2google.db   # a postgres://... URL in the cloud
# SECURE_COOKIES=false    # set true when served over HTTPS
# SYNC_INTERVAL_HOURS=3   # in-app scheduler interval; minimum 0.25 (15 minutes)

# --- Cloud (Vercel) only ------------------------------------------------------
# Protects /tasks/sync-all; Vercel's cron sends it automatically. 32+ characters:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# CRON_SECRET=REPLACE_ME
# Google Search Console "HTML tag" verification value (just the content="..." part).
# GOOGLE_SITE_VERIFICATION=REPLACE_ME
